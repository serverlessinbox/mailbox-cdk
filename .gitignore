.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

.env
cdk.out
lib
dist
release

# go-task's local up-to-date cache: one file per task holding a hash of its
# `sources:` globs. Per-machine, rewritten on every build, meaningless to anyone
# else's checkout.
.task/
gitversion.out
tsconfig.tsbuildinfo
packages/mailbox-cdk-shared/tsconfig.build.tsbuildinfo

# Build outputs and local dev files
.jsii
build.log
/build

# LICENSE copied into each published package by its prepack (root LICENSE is the source)
/packages/mailbox/LICENSE
/packages/mailbox-cognito/LICENSE

# Synthesized templates captured by `yarn template-baseline capture`
.template-baseline/
.github/copilot-instructions.md
