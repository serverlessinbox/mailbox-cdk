{
  "name": "@serverlessinbox/mailbox-cdk-shared",
  "version": "0.0.0",
  "description": "Shared CDK artifact-resolution infrastructure for mailbox packages",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./lambda-runtime": {
      "types": "./src/lambda-runtime.ts",
      "default": "./src/lambda-runtime.ts"
    }
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./lambda-runtime": {
        "types": "./lib/lambda-runtime.d.ts",
        "default": "./lib/lambda-runtime.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "artifact-registry.json",
    "Taskfile.yml",
    "jest.config.js",
    "tsconfig.json",
    "tsconfig.build.json",
    "!src/**/__tests__",
    "!lib/**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn prepare-manifest build && yarn bundle",
    "postpack": "yarn clean",
    "bundle": "task bundle",
    "publish:dev": "task publish:dev",
    "test": "tsc -p tsconfig.test.json && jest",
    "clean": "rm -rf lib *.tsbuildinfo"
  },
  "dependencies": {
    "@serverlessinbox/artifact-registry": "^0.3.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.5.0",
    "typanion": "^3.14.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1132.0",
    "@aws-sdk/client-cloudfront": "^3.1132.0",
    "@aws-sdk/client-route-53": "^3.1132.0",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/client-sfn": "^3.1132.0",
    "@serverlessinbox/artifact-registry-cdk": "^0.3.0",
    "@serverlessinbox/mailbox-bundler": "workspace:*",
    "@types/jest": "^29.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.10.1",
    "@types/unzipper": "^0.10.11",
    "aws-custom-resources": "^0.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.27.1",
    "jest": "^29.0.0",
    "mime-types": "^2.1.35",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3"
  }
}
