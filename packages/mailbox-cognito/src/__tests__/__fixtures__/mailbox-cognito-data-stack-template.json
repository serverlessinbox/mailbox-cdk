{
  "Description": "Serverless JMAP email server on AWS identity tier — Cognito user pool, authentication domain, and user groups.",
  "Parameters": {
    "cognitoDomainPrefix": {
      "Type": "String",
      "Description": "Cognito-managed domain prefix (globally unique). Required when no custom domain is provided."
    },
    "customDomainName": {
      "Type": "String",
      "Default": "",
      "Description": "Custom domain hostname for the Cognito hosted UI (e.g. auth.example.com). Leave empty to use the Cognito-managed prefix domain."
    },
    "customDomainCertArn": {
      "Type": "String",
      "Default": "",
      "Description": "ACM certificate ARN (must be in us-east-1) for the custom domain. Required when customDomainName is provided."
    },
    "mfaMode": {
      "Type": "String",
      "Default": "OPTIONAL",
      "AllowedValues": [
        "OFF",
        "OPTIONAL",
        "ON"
      ],
      "Description": "MFA enforcement: OFF disables MFA, OPTIONAL lets users enroll TOTP, ON requires TOTP for all users."
    },
    "passwordMinLength": {
      "Type": "Number",
      "Default": 8,
      "Description": "Minimum password length (6–99).",
      "MaxValue": 99,
      "MinValue": 6
    },
    "rootStack": {
      "Type": "String",
      "Default": "",
      "Description": "Root (main) CloudFormation stack name (regional stack that created this cognito stack)"
    },
    "productVersion": {
      "Type": "String",
      "Default": "unknown",
      "Description": "Serverless Inbox Mailbox stack version (for tagging/support)"
    },
    "deployerType": {
      "Type": "String",
      "Default": "cfn",
      "AllowedValues": [
        "cdk",
        "cfn",
        "marketplace"
      ],
      "Description": "Deployment mechanism label (cdk|cfn|marketplace) used for tagging"
    }
  },
  "Conditions": {
    "HasCustomDomain": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "customDomainName"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "userpool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "admin_only",
              "Priority": 1
            }
          ]
        },
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "MfaConfiguration": {
          "Ref": "mfaMode"
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": {
              "Ref": "passwordMinLength"
            },
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false,
            "RequireUppercase": true,
            "TemporaryPasswordValidityDays": 7
          }
        },
        "UserPoolName": {
          "Fn::Sub": "${AWS::AccountId}-${AWS::StackName}-users"
        },
        "UserPoolTags": {
          "Name": "user-pool",
          "serverless-inbox:component": "auth",
          "serverless-inbox:deployer_type": {
            "Ref": "deployerType"
          },
          "serverless-inbox:description": "ServerlessInbox identity - Cognito user directory. - cognito user pool",
          "serverless-inbox:product": "mailbox",
          "serverless-inbox:root-stack": {
            "Ref": "rootStack"
          },
          "serverless-inbox:stack": {
            "Ref": "AWS::StackName"
          },
          "serverless-inbox:version": {
            "Ref": "productVersion"
          }
        }
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate"
    },
    "userpooldomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "CustomDomainConfig": {
          "Fn::If": [
            "HasCustomDomain",
            {
              "certificateArn": {
                "Ref": "customDomainCertArn"
              }
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Domain": {
          "Fn::If": [
            "HasCustomDomain",
            {
              "Ref": "customDomainName"
            },
            {
              "Ref": "cognitoDomainPrefix"
            }
          ]
        },
        "UserPoolId": {
          "Ref": "userpool"
        }
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate"
    },
    "userpoolresourceserver": {
      "Type": "AWS::Cognito::UserPoolResourceServer",
      "Properties": {
        "Identifier": "si",
        "Name": "JMAP API",
        "Scopes": [
          {
            "ScopeDescription": "Read emails",
            "ScopeName": "mail.read"
          },
          {
            "ScopeDescription": "Write emails",
            "ScopeName": "mail.write"
          },
          {
            "ScopeDescription": "Send emails",
            "ScopeName": "mail.send"
          },
          {
            "ScopeDescription": "Read account",
            "ScopeName": "account.read"
          },
          {
            "ScopeDescription": "Read aliases",
            "ScopeName": "alias.read"
          },
          {
            "ScopeDescription": "Write aliases",
            "ScopeName": "alias.write"
          },
          {
            "ScopeDescription": "Read user",
            "ScopeName": "user.read"
          },
          {
            "ScopeDescription": "Read contacts",
            "ScopeName": "contacts.read"
          },
          {
            "ScopeDescription": "Write contacts",
            "ScopeName": "contacts.write"
          },
          {
            "ScopeDescription": "Admin access",
            "ScopeName": "admin"
          }
        ],
        "UserPoolId": {
          "Ref": "userpool"
        }
      }
    },
    "groupadmin": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "Description": "Serverless Inbox administrator group",
        "GroupName": "admin",
        "UserPoolId": {
          "Ref": "userpool"
        }
      }
    },
    "groupuser": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "Description": "Serverless Inbox standard user group",
        "GroupName": "user",
        "UserPoolId": {
          "Ref": "userpool"
        }
      }
    }
  },
  "Outputs": {
    "userPoolId": {
      "Value": {
        "Ref": "userpool"
      }
    },
    "userPoolArn": {
      "Value": {
        "Fn::Sub": [
          "arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${PoolId}",
          {
            "PoolId": {
              "Ref": "userpool"
            }
          }
        ]
      }
    },
    "oauthDomain": {
      "Value": {
        "Fn::If": [
          "HasCustomDomain",
          {
            "Ref": "customDomainName"
          },
          {
            "Fn::Sub": [
              "${Prefix}.auth.${AWS::Region}.amazoncognito.com",
              {
                "Prefix": {
                  "Ref": "cognitoDomainPrefix"
                }
              }
            ]
          }
        ]
      }
    }
  }
}