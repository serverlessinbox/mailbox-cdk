{
  "functions": {
    "fn:stack-deployer:stack-deployer-cognito-worker": {
      "envVarNames": [
        "SERVICE_NAME"
      ],
      "eventSources": [],
      "roleKey": "role:fn:stack-deployer:stack-deployer-cognito-worker"
    },
    "fn:stack-deployer:stack-deployer-cognito-starter": {
      "envVarNames": [
        "MAILBOX_STACK_DEPLOYER_STATE_MACHINE_ARN",
        "SERVICE_NAME"
      ],
      "eventSources": [],
      "roleKey": "role:fn:stack-deployer:stack-deployer-cognito-starter"
    },
    "fn:cognito-idp-users-api:cognito-idp-users-api": {
      "envVarNames": [
        "ADMIN_GROUPS",
        "AUDIT_EVENTS_QUEUE_URL",
        "SERVICE_NAME",
        "USER_GROUPS",
        "USER_POOL_ID"
      ],
      "eventSources": [],
      "roleKey": "role:fn:cognito-idp-users-api:cognito-idp-users-api"
    }
  },
  "roles": {
    "role:fn:stack-deployer:stack-deployer-cognito-worker": {
      "trustPolicy": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          }
        }
      ],
      "managedPolicyArns": [
        {
          "Fn::Join": [
            "",
            [
              "arn:",
              {
                "ref": "AWS::Partition"
              },
              ":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
            ]
          ]
        }
      ],
      "permissionsBoundary": null,
      "statements": [
        {
          "Action": "cloudformation:ValidateTemplate",
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": "cognito-idp:CreateUserPool",
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": "cognito-idp:DescribeUserPoolDomain",
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": "cognito-idp:TagResource",
          "Condition": {
            "StringEquals": {
              "aws:RequestTag/serverless-inbox:root-stack": {
                "ref": "AWS::StackName"
              }
            },
            "ForAllValues:StringEquals": {
              "aws:TagKeys": [
                "serverless-inbox:product",
                "serverless-inbox:root-stack",
                "serverless-inbox:stack",
                "serverless-inbox:component",
                "serverless-inbox:version",
                "serverless-inbox:deployer_type"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": "cognito-idp:TagResource",
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/serverless-inbox:root-stack": {
                "ref": "AWS::StackName"
              }
            },
            "ForAllValues:StringEquals": {
              "aws:TagKeys": [
                "serverless-inbox:product",
                "serverless-inbox:root-stack",
                "serverless-inbox:stack",
                "serverless-inbox:component",
                "serverless-inbox:version",
                "serverless-inbox:deployer_type"
              ]
            }
          },
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "cloudformation:CreateStack",
            "cloudformation:DeleteStack",
            "cloudformation:DescribeStackEvents",
            "cloudformation:DescribeStacks",
            "cloudformation:GetStackPolicy",
            "cloudformation:GetTemplate",
            "cloudformation:GetTemplateSummary",
            "cloudformation:SetStackPolicy",
            "cloudformation:UpdateStack"
          ],
          "Effect": "Allow",
          "Resource": {
            "Fn::Join": [
              "",
              [
                "arn:aws:cloudformation:",
                {
                  "ref": "AWS::Region"
                },
                ":",
                {
                  "ref": "AWS::AccountId"
                },
                ":stack/",
                {
                  "ref": "AWS::StackName"
                },
                "-cognito/*"
              ]
            ]
          }
        },
        {
          "Action": [
            "cognito-idp:CreateGroup",
            "cognito-idp:DeleteGroup",
            "cognito-idp:GetGroup",
            "cognito-idp:UpdateGroup"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/serverless-inbox:root-stack": {
                "ref": "AWS::StackName"
              }
            }
          },
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "cognito-idp:CreateResourceServer",
            "cognito-idp:DeleteResourceServer",
            "cognito-idp:DescribeResourceServer",
            "cognito-idp:UpdateResourceServer"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/serverless-inbox:root-stack": {
                "ref": "AWS::StackName"
              }
            }
          },
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "cognito-idp:CreateUserPoolDomain",
            "cognito-idp:DeleteUserPoolDomain",
            "cognito-idp:UpdateUserPoolDomain"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/serverless-inbox:root-stack": {
                "ref": "AWS::StackName"
              }
            }
          },
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "cognito-idp:DeleteUserPool",
            "cognito-idp:DescribeUserPool",
            "cognito-idp:GetUserPoolMfaConfig",
            "cognito-idp:ListTagsForResource",
            "cognito-idp:SetUserPoolMfaConfig",
            "cognito-idp:UntagResource",
            "cognito-idp:UpdateUserPool"
          ],
          "Condition": {
            "StringEquals": {
              "aws:ResourceTag/serverless-inbox:root-stack": {
                "ref": "AWS::StackName"
              }
            }
          },
          "Effect": "Allow",
          "Resource": "*"
        },
        {
          "Action": [
            "s3:GetObject",
            "s3:GetObjectVersion"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::test-artifacts-us-west-2/serverlessinbox/packages/mailbox-cognito/releases/v0.0.1-test/cognito-data-stack-template.json"
        },
        {
          "Action": [
            "tag:GetResources",
            "tag:TagResources",
            "tag:UntagResources"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ]
    },
    "role:fallback:MailboxUserPool/cognito-deployer/infra/workflow/StateMachine": {
      "trustPolicy": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "states.amazonaws.com"
          }
        }
      ],
      "managedPolicyArns": [],
      "permissionsBoundary": null,
      "statements": [
        {
          "Action": "lambda:InvokeFunction",
          "Effect": "Allow",
          "Resource": [
            {
              "ref": "fn:stack-deployer:stack-deployer-cognito-worker",
              "attr": "Arn"
            },
            {
              "Fn::Join": [
                "",
                [
                  {
                    "ref": "fn:stack-deployer:stack-deployer-cognito-worker",
                    "attr": "Arn"
                  },
                  ":*"
                ]
              ]
            }
          ]
        }
      ]
    },
    "role:fn:stack-deployer:stack-deployer-cognito-starter": {
      "trustPolicy": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          }
        }
      ],
      "managedPolicyArns": [
        {
          "Fn::Join": [
            "",
            [
              "arn:",
              {
                "ref": "AWS::Partition"
              },
              ":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
            ]
          ]
        }
      ],
      "permissionsBoundary": null,
      "statements": [
        {
          "Action": "states:DescribeExecution",
          "Effect": "Allow",
          "Resource": {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "ref": "AWS::Partition"
                },
                ":states:us-west-2:123456789012:execution:",
                {
                  "Fn::Join": [
                    ":",
                    [
                      {
                        "Fn::Join": [
                          "",
                          [
                            "mailbox-cognito-data-deployer-v2-",
                            {
                              "Fn::Select": [
                                2,
                                {
                                  "Fn::Split": [
                                    "/",
                                    {
                                      "ref": "AWS::StackId"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        ]
                      },
                      "*"
                    ]
                  ]
                }
              ]
            ]
          }
        },
        {
          "Action": "states:StartExecution",
          "Effect": "Allow",
          "Resource": {
            "ref": "fallback:MailboxUserPool/cognito-deployer/infra/workflow/StateMachine"
          }
        }
      ]
    },
    "role:fn:cognito-idp-users-api:cognito-idp-users-api": {
      "trustPolicy": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          }
        }
      ],
      "managedPolicyArns": [
        {
          "Fn::Join": [
            "",
            [
              "arn:",
              {
                "ref": "AWS::Partition"
              },
              ":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
            ]
          ]
        }
      ],
      "permissionsBoundary": null,
      "statements": [
        {
          "Action": "sqs:SendMessage",
          "Effect": "Allow",
          "Resource": {
            "ref": "fallback:TestAuditEventsQueue",
            "attr": "Arn"
          }
        },
        {
          "Action": [
            "cognito-idp:AdminAddUserToGroup",
            "cognito-idp:AdminCreateUser",
            "cognito-idp:AdminDeleteUser",
            "cognito-idp:AdminDisableUser",
            "cognito-idp:AdminEnableUser",
            "cognito-idp:AdminGetUser",
            "cognito-idp:AdminListGroupsForUser",
            "cognito-idp:AdminRemoveUserFromGroup",
            "cognito-idp:AdminResetUserPassword",
            "cognito-idp:AdminSetUserPassword",
            "cognito-idp:AdminUpdateUserAttributes",
            "cognito-idp:ListGroups",
            "cognito-idp:ListUsers",
            "cognito-idp:ListUsersInGroup"
          ],
          "Effect": "Allow",
          "Resource": {
            "ref": "fallback:MailboxUserPool/cognito-deployer/resource",
            "attr": "userPoolArn"
          }
        }
      ]
    }
  },
  "resourcePolicies": {}
}