{
  "name": "@serverlessinbox/mailbox-cognito",
  "version": "0.0.0",
  "author": "Joost van der Waal <joost@jvdwaal.nl>",
  "repository": {
    "type": "git",
    "url": "https://github.com/serverlessinbox/mailbox-cdk",
    "directory": "packages/mailbox-cognito"
  },
  "homepage": "https://docs.serverlessinbox.com",
  "bugs": {
    "url": "https://github.com/serverlessinbox/serverlessinbox/issues"
  },
  "keywords": [
    "aws",
    "cdk",
    "serverless",
    "email",
    "cognito",
    "mailbox"
  ],
  "license": "Apache-2.0",
  "description": "Cognito auth constructs for Serverless Inbox Mailbox",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "build": "jsii --tsconfig tsconfig.build.json",
    "build:watch": "tsc --watch",
    "prepack": "node -e \"const fs=require('fs');fs.rmSync('lib',{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tsbuildinfo'))fs.rmSync(f)\" && yarn prepare-manifest build && node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && yarn build:cognito-data-stack && yarn bundle && yarn bundle:jsii && yarn check:declarations",
    "test": "tsc -p tsconfig.test.json && jest",
    "clean": "rm -rf dist lib *.tsbuildinfo",
    "dev": "task build:watch",
    "bundle": "task bundle",
    "bundle:jsii": "mailbox-bundler package .",
    "check:declarations": "mailbox-bundler check-declarations .",
    "publish:dev": "task publish:dev",
    "build:cognito-data-stack": "task build:cognito-data-stack"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "access": "public"
  },
  "jsii": {
    "outdir": "dist",
    "tsconfig": "tsconfig.json",
    "targets": {
      "go": {
        "moduleName": "github.com/serverlessinbox/mailbox-cognito-go"
      }
    },
    "excludeTypescript": [
      "src/runtime/**"
    ]
  },
  "peerDependencies": {
    "@serverlessinbox/artifact-registry-cdk": "^0.3.0",
    "@serverlessinbox/mailbox": "workspace:*",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1132.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1132.0",
    "@aws-sdk/client-lambda": "^3.1132.0",
    "@aws-sdk/client-sqs": "^3.1132.0",
    "@bufbuild/protobuf": "^2.2.3",
    "@serverlessinbox/artifact-registry": "^0.3.0",
    "@serverlessinbox/artifact-registry-cdk": "^0.3.0",
    "@serverlessinbox/mailbox": "workspace:*",
    "@serverlessinbox/mailbox-addon-sdk": "workspace:*",
    "@serverlessinbox/mailbox-bundler": "workspace:*",
    "@serverlessinbox/mailbox-cdk-shared": "workspace:*",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.10.1",
    "aws-cdk-lib": "^2.261.0",
    "aws-custom-resources": "^0.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.27.1",
    "jest": "^29.0.0",
    "jsii": "^5.9.44",
    "jsii-pacmak": "1.120.0",
    "jsii-rosetta": "^5.9.15",
    "ts-jest": "^29.0.0",
    "typanion": "^3.14.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib",
    ".jsii",
    "artifact-versions.json",
    "registry-record.json",
    "LICENSE",
    "!lib/**/__tests__",
    "!lib/runtime/**/*.js"
  ]
}
