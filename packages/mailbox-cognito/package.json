{
  "name": "@serverlessinbox/mailbox-cognito",
  "version": "0.0.0",
  "author": "Joost van der Waal",
  "repository": {
    "url": "https://github.com/serverlessinbox/mailbox-cdk",
    "type": "git"
  },
  "license": "Apache-2.0",
  "description": "Cognito auth constructs for Serverless Inbox Mailbox",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "jsii --tsconfig tsconfig.build.json",
    "build:watch": "tsc --watch",
    "prepack": "yarn prepare-manifest build && yarn build:cognito-data-stack && yarn bundle",
    "postpack": "yarn clean",
    "lint": "eslint .",
    "test": "jest",
    "clean": "rm -rf dist lib",
    "dev": "task build:watch",
    "bundle": "task bundle",
    "publish:dev": "task publish:dev",
    "build:cognito-data-stack": "task build:cognito-data-stack"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "access": "public"
  },
  "jsii": {
    "outdir": "dist",
    "tsconfig": "tsconfig.json",
    "targets": {
      "go": {
        "moduleName": "github.com/serverlessinbox/mailbox-cognito-go"
      }
    }
  },
  "peerDependencies": {
    "@serverlessinbox/mailbox": "workspace:*",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.947.0",
    "@aws-sdk/client-sqs": "^3.947.0",
    "@bufbuild/protobuf": "^2.2.3",
    "@serverlessinbox/artifact-registry": "^0.0.37",
    "@serverlessinbox/mailbox": "workspace:*",
    "@serverlessinbox/mailbox-admin-api": "workspace:*",
    "@serverlessinbox/mailbox-bundler": "workspace:*",
    "@serverlessinbox/mailbox-cdk-shared": "workspace:*",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^24.10.1",
    "aws-cdk-lib": "^2.261.0",
    "aws-sdk-client-mock": "^3.0.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.27.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "jsii": "^5.9.44",
    "jsii-pacmak": "*",
    "jsii-rosetta": "^5.9.15",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "src",
    "lib",
    "artifact-versions.json"
  ],
  "serverlessinbox": {
    "components": {
      "mailbox-go": {
        "version": {
          "version": "0.0.0",
          "zone": "regional"
        }
      },
      "mailbox-admin-ui": {
        "version": {
          "version": "0.0.0",
          "zone": "regional"
        }
      },
      "mailbox-webmail-ui": {
        "version": {
          "version": "0.0.0",
          "zone": "regional"
        }
      }
    }
  }
}
