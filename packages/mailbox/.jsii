    "@serverlessinbox/mailbox.MailboxProps": {
      "assembly": "@serverlessinbox/mailbox",
      "datatype": true,
      "docs": {
        "summary": "Settings of a {@link Mailbox}: the DNS and certificate setup, the authentication provider, which UIs and optional capabilities to create, and how artifacts are resolved."
      },
      "fqn": "@serverlessinbox/mailbox.MailboxProps",
