          "type": {
            "primitive": "string"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "Duration.hours(6)",
            "remarks": "Ignored when `granularity` is `'pinned'`,\nbecause the schedule is not created then.",
            "summary": "How often the updater checks for newer releases."
          },
          "immutable": true,
          "locationInModule": {
