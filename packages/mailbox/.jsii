          "name": "enableReceiving",
          "optional": true,
          "type": {
            "primitive": "string"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "true",
            "remarks": "Disabling it makes synthesis fail, because the JMAP API requires the JMAP UI\nOAuth client that the Webmail UI provisions.",
            "summary": "Whether to create the Webmail UI: the CloudFront distribution, its token-exchange API and its OAuth client."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 277
