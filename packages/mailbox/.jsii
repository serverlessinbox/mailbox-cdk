    "@serverlessinbox/mailbox.MailboxResourceDescriptionsOptions": {
      "assembly": "@serverlessinbox/mailbox",
      "datatype": true,
      "docs": {
        "remarks": "Per visited L1:\n- `Name` tag = path tail under Mailbox (trailing `/Resource` or `/Default` stripped).\n- `serverless-inbox:description` tag = `\"<component sentence> (<structural role>)\"`, clamped to\n  256 chars — on every taggable resource (universal; shows in the Tags tab for tables/queues/etc).\n- Native `Description` / `Comment` = the component sentence (no role suffix), only if currently\n  unset, on lambda.CfnFunction, iam.CfnRole, apigatewayv2.CfnApi, apigatewayv2.CfnStage,\n  events.CfnRule, and cloudfront.CfnDistribution.\n- iam.CfnManagedPolicy is intentionally skipped (Description triggers replacement).\n\nAll tags are written via TagManager.setTag (guarded by isTaggable), never `Tags.of()`, which\nwould spawn a Tag sub-aspect and trip CDK's aspect-ordering / infinite-loop guards.",
        "summary": "CDK Aspect that adds identity metadata to every L1 resource under the Mailbox construct so the stack is self-explanatory in a customer's AWS console."
      },
      "fqn": "@serverlessinbox/mailbox.MailboxResourceDescriptionsOptions",
      "kind": "interface",
      "locationInModule": {
        "filename": "src/utils/resource-descriptions.ts",
        "line": 186
      },
      "name": "MailboxResourceDescriptionsOptions",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "summary": "Component sentence used whenever the COMPONENT_DESCRIPTIONS lookup misses (e.g. sub-stack resources whose ids aren't in the main-stack component map). Defaults to a path-derived string."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/utils/resource-descriptions.ts",
            "line": 191
          },
          "name": "fallbackDescription",
          "optional": true,
          "type": {
            "primitive": "string"
          }
        }
      ],
      "symbolId": "src/utils/resource-descriptions:MailboxResourceDescriptionsOptions"
    },
