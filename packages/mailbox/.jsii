    "@serverlessinbox/mailbox.IDataTable": {
      "assembly": "@serverlessinbox/mailbox",
      "docs": {
        "remarks": "Use it to\nread the table's identity and to grant a Lambda or role access — never to reach the underlying\ntable for anything else, since none is exposed.\n\nThe implementation wraps a table owned and created by the data sub-stack; this interface never\ncreates, imports, or configures a table itself. One shape covers all five tables — nothing here\ndistinguishes which table a given `IDataTable` points at, so a construct's props still name the\ntable they expect (`configTable: IDataTable`, `itemTable: IDataTable`, …) for readability, but\nthe type system does not reject a mismatched argument at the call site.",
        "summary": "A handle to one of the data sub-stack's DynamoDB tables (config, item, changelog, audit log, or mail feedback), given to code outside that sub-stack instead of a raw CDK `ITable`."
      },
      "fqn": "@serverlessinbox/mailbox.IDataTable",
      "kind": "interface",
      "locationInModule": {
        "filename": "src/data/data-tables.ts",
        "line": 17
      },
      "methods": [
        {
          "abstract": true,
          "docs": {
            "remarks": "Does not include `Scan` or PartiQL\n(`ExecuteStatement`) — nothing in this codebase needs either, so neither is granted.",
            "summary": "Grants `grantee` read-only access to the table and its indexes: `dynamodb:GetItem`, `dynamodb:BatchGetItem`, and `dynamodb:Query`."
          },
          "locationInModule": {
            "filename": "src/data/data-tables.ts",
            "line": 28
          },
          "name": "grantRead",
          "parameters": [
            {
              "name": "grantee",
              "type": {
                "fqn": "aws-cdk-lib.aws_iam.IGrantable"
              }
            }
          ]
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Use this only when the grantee genuinely\nmutates the table — prefer {@link grantRead} for anything that only reads.",
            "summary": "Grants `grantee` the {@link grantRead} actions plus write access: `dynamodb:PutItem`, `dynamodb:UpdateItem`, and `dynamodb:DeleteItem`."
          },
          "locationInModule": {
            "filename": "src/data/data-tables.ts",
            "line": 35
          },
          "name": "grantReadWrite",
          "parameters": [
            {
              "name": "grantee",
              "type": {
                "fqn": "aws-cdk-lib.aws_iam.IGrantable"
              }
            }
          ]
        }
      ],
      "name": "IDataTable",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "summary": "The table's ARN, e.g. for use in a hand-written IAM policy statement that needs it directly."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/data/data-tables.ts",
            "line": 21
          },
          "name": "tableArn",
          "type": {
            "primitive": "string"
          }
        },
        {
          "abstract": true,
          "docs": {
            "summary": "The table's physical name, as CloudFormation assigns it."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/data/data-tables.ts",
            "line": 19
          },
          "name": "tableName",
          "type": {
            "primitive": "string"
          }
        }
      ],
      "symbolId": "src/data/data-tables:IDataTable"
    },
