          "optional": true,
          "type": {
            "primitive": "boolean"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "- only the UI origins are allowed",
            "remarks": "The\norigins of the Admin and Webmail UIs are added automatically.",
            "summary": "Extra origins allowed by CORS on the Admin API, the JMAP API and the CDN, as full origins including the scheme, for example `http://localhost:5173` during local development."
          },
          "immutable": true,
          "locationInModule": {
