        "line": 205
      },
      "name": "MailboxProps",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "remarks": "Required.\n\nPass the provider your users sign in with: its issuer is what the Mailbox is configured to\ntrust.",
            "summary": "The construct that supplies authentication: the identity issuer and its token and authorization endpoints, the auth policies, the OAuth client settings and, optionally, Admin API and JMAP API addons."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 230
          },
          "name": "authProvider",
          "type": {
            "fqn": "@serverlessinbox/mailbox.IMailboxAuthProvider"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "- no additional providers",
            "remarks": "Nothing beyond the addons your `authProvider` contributes is enabled\nunless a provider is listed here.",
            "summary": "Providers that add capabilities to the Admin API, such as `StackUpdateAddonProvider` or `SupportAddonProvider`."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 248
          },
          "name": "adminApiAddonProviders",
          "optional": true,
          "type": {
            "collection": {
              "elementtype": {
                "fqn": "@serverlessinbox/mailbox.IAdminApiAddonProvider"
              },
              "kind": "array"
            }
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "- a pinned resolver",
            "remarks": "When\nomitted, a pinned resolver built from the artifact versions shipped with the package is used,\nso a deploy ships exactly those versions. Inject an `AutoUpdater` to additionally keep the\ndeployed artifacts up to date with newer releases.",
            "summary": "The resolver that locates the Lambda code and UI bundle artifacts the Mailbox deploys."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 314
          },
          "name": "artifactResolver",
          "optional": true,
          "type": {
            "fqn": "@serverlessinbox/artifact-registry-cdk.IArtifactResolver"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "true",
            "remarks": "When false, there is no Admin UI OAuth client and no Admin UI origin in the CORS\nallow-lists.",
            "summary": "Whether to create the Admin UI: the CloudFront distribution, its token-exchange API and its OAuth client."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 268
          },
          "name": "enableAdminUi",
          "optional": true,
          "type": {
            "primitive": "boolean"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "false",
            "summary": "Whether to activate the MCP (Model Context Protocol) API at mcp.<domain>. Requires an Advanced license tier. The MCP endpoint uses the regional certificate the Mailbox creates, so it also requires `hostedZoneId`, and `overrides.certificates` must not supply both `api` and `jmap`, or no regional certificate is created."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 287
          },
          "name": "enableMcp",
          "optional": true,
          "type": {
            "primitive": "boolean"
          }
        },
        {
          "abstract": true,
          "docs": {
            "default": "- the Bootstrap Lambda's default receiving behavior",
            "remarks": "Only one rule set can be active per\naccount per region, so activating this one replaces whichever is active: choose it\ndeliberately.",
            "summary": "The mode (`'off'`, `'on'` or `'forced'`) the Bootstrap Lambda uses when it activates the SES receipt rule set by calling SetActiveReceiptRuleSet."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 297
