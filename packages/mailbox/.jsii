        },
        {
          "abstract": true,
          "docs": {
            "default": "'minor'",
            "remarks": "Pass `'pinned'` to disable automatic\nupdates: the post-deploy trigger and the schedule are then not created, and the updater only\nruns when invoked from the admin API.\n\nAccepts a CloudFormation parameter token, so a stack parameter can switch tracking on and\noff at deploy time. The prop is typed `string` for that reason, so a literal other than\n`'major'`, `'minor'` or `'pinned'` is not caught at compile time.",
            "summary": "How the updater derives the release track it follows from a deployed artifact's version: `'major'` or `'minor'` (see {@link Granularity})."
          },
          "immutable": true,
          "locationInModule": {
