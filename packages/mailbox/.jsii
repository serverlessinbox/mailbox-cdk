      "datatype": true,
      "docs": {
        "remarks": "Every field left out falls back to the certificate the Mailbox creates\nitself, which requires `MailboxProps.hostedZoneId`.",
        "summary": "Your own ACM certificates for the endpoints a Mailbox serves, for when you manage DNS and certificates yourself."
      },
      "fqn": "@serverlessinbox/mailbox.MailboxCertificateOverrides",
      "kind": "interface",
      "locationInModule": {
        "filename": "src/mailbox.ts",
        "line": 59
      },
      "name": "MailboxCertificateOverrides",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "remarks": "Takes precedence over the edge certificate the Mailbox creates when a hosted zone is given.\nWithout a hosted zone and without this certificate, the Admin UI is served on its default\nCloudFront domain.",
            "summary": "Certificate attached to the Admin UI's alternate domain name (admin.<domain>). It must be issued in us-east-1, because CloudFront only accepts certificates from there."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 77
          },
          "name": "adminUi",
          "optional": true,
          "type": {
            "fqn": "aws-cdk-lib.aws_certificatemanager.ICertificate"
          }
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Takes precedence over the regional certificate the Mailbox creates when a hosted zone is\ngiven. Without a hosted zone and without this certificate, the Admin API gets no custom\ndomain, and the Admin UI is not given an API URL.",
            "summary": "Certificate for the Admin API's custom domain (api.<domain>). It must be issued in the same region as the stack, because API Gateway custom domains use regional certificates."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 95
          },
          "name": "api",
          "optional": true,
          "type": {
            "fqn": "aws-cdk-lib.aws_certificatemanager.ICertificate"
          }
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Used only when `MailboxProps.hostedZoneId` is not set; with a hosted zone the Mailbox's own\nedge certificate is used and this field is ignored. Without a hosted zone and without this\ncertificate, the CDN is served on its default CloudFront domain.",
            "summary": "Certificate attached to the CDN's alternate domain name (cdn.<domain>). It must be issued in us-east-1, because CloudFront only accepts certificates from there."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 68
          },
          "name": "cloudFront",
          "optional": true,
          "type": {
            "fqn": "aws-cdk-lib.aws_certificatemanager.ICertificate"
          }
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Takes precedence over the regional certificate the Mailbox creates when a hosted zone is\ngiven. Without a hosted zone and without this certificate, the JMAP API gets no custom\ndomain, and the Webmail UI is not given an API URL.",
            "summary": "Certificate for the JMAP API's custom domain (jmap.<domain>). It must be issued in the same region as the stack, because API Gateway custom domains use regional certificates."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
            "line": 104
          },
          "name": "jmap",
          "optional": true,
          "type": {
            "fqn": "aws-cdk-lib.aws_certificatemanager.ICertificate"
          }
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Takes precedence over the edge certificate the Mailbox creates when a hosted zone is given.\nWithout a hosted zone and without this certificate, the Webmail UI is served on its default\nCloudFront domain.",
            "summary": "Certificate attached to the Webmail UI's alternate domain name (webmail.<domain>). It must be issued in us-east-1, because CloudFront only accepts certificates from there."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/mailbox.ts",
