          "abstract": true,
          "docs": {
            "remarks": "The Mailbox derives the domain name from the\nzone at deploy time, creates DNS records for its endpoints in it, and creates the ACM\ncertificates they need.\n\nWhen omitted, no DNS records or certificates are created: supply your own through\n`overrides.certificates` and point DNS at the endpoints yourself.",
            "summary": "The Route53 hosted zone that serves your domain."
          },
          "immutable": true,
