    "@serverlessinbox/mailbox.AutoUpdaterProps": {
      "assembly": "@serverlessinbox/mailbox",
      "datatype": true,
      "docs": {
        "summary": "Settings of the {@link AutoUpdater}: which release line to follow, how tightly, and how often the scheduled check runs."
      },
      "fqn": "@serverlessinbox/mailbox.AutoUpdaterProps",
      "kind": "interface",
      "locationInModule": {
        "filename": "src/artifacts/resolvers/auto-updater.ts",
        "line": 30
      },
      "name": "AutoUpdaterProps",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "default": "'stable'",
            "remarks": "The updater reads\nthe release pointer published for this tag and moves deployed artifacts to the version it\nnames.",
            "summary": "The release line (dist-tag) the updater follows, for example `'stable'`."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/artifacts/resolvers/auto-updater.ts",
