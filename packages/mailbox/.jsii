  "types": {
    "@serverlessinbox/mailbox.AdminApiAddonContext": {
      "assembly": "@serverlessinbox/mailbox",
      "datatype": true,
      "docs": {
        "remarks": "Passed to\nevery {@link IAdminApiAddonProvider.createAdminApiAddons} call so an addon does not have to\nreach into `Mailbox` internals to get them.",
        "summary": "What an admin-api addon needs to build its own Lambda: the audit-events queue, the shared config and audit-log tables, the identity provisioner and the artifact resolver."
      },
      "fqn": "@serverlessinbox/mailbox.AdminApiAddonContext",
      "kind": "interface",
      "locationInModule": {
        "filename": "src/api/addons.ts",
        "line": 44
      },
      "name": "AdminApiAddonContext",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "summary": "The artifact resolver the Mailbox resolves its own artifacts with: the one injected through `MailboxProps.artifactResolver`, or the Mailbox's default pinned resolver when none was injected. Resolve your addon's Lambda code through this so it ships at the same artifact version as the rest of the Mailbox, instead of asking the consumer for a second resolver."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/api/addons.ts",
            "line": 73
          },
          "name": "artifactResolver",
          "type": {
            "fqn": "@serverlessinbox/artifact-registry-cdk.IArtifactResolver"
          }
