    "@serverlessinbox/mailbox.IAuditEventsQueue": {
      "assembly": "@serverlessinbox/mailbox",
      "docs": {
        "remarks": "Any Lambda that emits an audit event (admin-api, jmap-api, the identity provisioner,\nthe support and stack-update addons, and more) depends on this interface to enqueue a message\nand to build its own `AUDIT_EVENTS_QUEUE_URL` environment variable — it never needs to consume\nfrom this queue.\n\nPass the `AuditEventsQueue` instance `AuditWriting` creates; there is no other implementation.",
        "summary": "Send-only access to the audit-events queue, without exposing the underlying SQS queue construct."
      },
      "fqn": "@serverlessinbox/mailbox.IAuditEventsQueue",
      "kind": "interface",
      "locationInModule": {
        "filename": "src/features/audit-writing/audit-events-queue.ts",
        "line": 20
      },
      "methods": [
        {
          "abstract": true,
          "docs": {
            "remarks": "Call this from inside your own Lambda's constructor once you hold this interface — never grant\non a queue you were merely handed a reference to from outside the grantee's own construct.",
            "summary": "Grants the given principal permission to send messages to this queue (`sqs:SendMessage` only)."
          },
          "locationInModule": {
            "filename": "src/features/audit-writing/audit-events-queue.ts",
            "line": 35
          },
          "name": "grantSend",
          "parameters": [
            {
              "name": "grantee",
              "type": {
                "fqn": "aws-cdk-lib.aws_iam.IGrantable"
              }
            }
          ]
        }
      ],
      "name": "IAuditEventsQueue",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "summary": "The queue's ARN, needed to wire a consumer's own SQS event source mapping."
          },
          "immutable": true,
          "locationInModule": {
            "filename": "src/features/audit-writing/audit-events-queue.ts",
            "line": 28
          },
          "name": "queueArn",
          "type": {
            "primitive": "string"
          }
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Set this as the\nenv var your Lambda reads to enqueue audit events — never construct the URL by hand.",
