      "assembly": "@serverlessinbox/mailbox",
      "docs": {
        "remarks": "Pass a literal value to decide at synth time. Pass a CloudFormation parameter token to decide at\ndeploy time: the support resources are then always in the template, behind a condition on the\nparameter, and a deployer can switch the feature on or off without re-synthesizing.",
        "summary": "Whether the support feature is provisioned."
      },
      "fqn": "@serverlessinbox/mailbox.SupportMode",
