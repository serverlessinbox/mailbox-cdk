          }
        },
        {
          "abstract": true,
          "docs": {
            "remarks": "Used only when `MailboxProps.hostedZoneId` is set: it then takes precedence over the regional\ncertificate the Mailbox creates. Without a hosted zone the WebSocket endpoint gets no custom\ndomain and this field is ignored.",
            "summary": "Certificate for the WebSocket push custom domain (ws.<domain>). It must be issued in the same region as the stack, because API Gateway custom domains use regional certificates."
          },
          "immutable": true,
          "locationInModule": {
