{
  "name": "@mailbox/cdk",
  "version": "1.0.0",
  "author": "Joost van der Waal",
  "repository": {
    "url": "https://github.com/serverlessinbox/mailbox-cdk",
    "type": "git"
  },
  "license": "Apache-2.0",
  "description": "CDK construct library for Mailbox infrastructure",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "tsc --noEmit",
    "build:watch": "tsc --noEmit --watch",
    "jsii:build": "jsii",
    "jsii:package": "jsii-pacmak",
    "prepack": "jsii",
    "postpack": "rm -rf lib dist",
    "lint": "eslint .",
    "test": "jest",
    "dev": "yarn build:watch"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts"
  },
  "jsii": {
    "outdir": "dist",
    "tsconfig": "tsconfig.json",
    "targets": {
      "go": {
        "moduleName": "github.com/serverlessinbox/mailbox-cdk-go"
      }
    }
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.224.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-cdk-lib": "^2.224.0",
    "constructs": "^10.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "jsii": "^5.3.0",
    "jsii-pacmak": "*",
    "jsii-rosetta": "^5.9.15",
    "ts-jest": "^29.0.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-go-alpha": "^2.214.1-alpha.0",
    "@aws-sdk/client-dynamodb": "^3.946.0",
    "@aws-sdk/util-dynamodb": "^3.946.0",
    "jsonwebtoken": "^9.0.3"
  },
  "files": [
    "src",
    "lib"
  ]
}
