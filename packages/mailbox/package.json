{
  "name": "@serverlessinbox/mailbox",
  "version": "0.0.0",
  "author": "Joost van der Waal",
  "repository": {
    "url": "https://github.com/serverlessinbox/mailbox-cdk",
    "type": "git"
  },
  "license": "Apache-2.0",
  "description": "CDK construct library for Mailbox infrastructure",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "jsii --tsconfig tsconfig.build.json",
    "build:watch": "tsc --watch",
    "build:edge-stack": "task build:edge-stack",
    "prepack": "yarn prepare-manifest build && yarn build:edge-stack && yarn bundle",
    "postpack": "yarn clean",
    "lint": "eslint .",
    "test": "jest",
    "clean": "rm -rf dist lib",
    "dev": "task build:watch",
    "bundle": "task bundle",
    "publish:dev": "task publish:dev"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "access": "public"
  },
  "jsii": {
    "outdir": "dist",
    "tsconfig": "tsconfig.json",
    "targets": {
      "go": {
        "moduleName": "github.com/serverlessinbox/mailbox-cdk-go"
      }
    },
    "excludeTypescript": [
      "src/lambdas/**",
      "src/ts-lambdas/**"
    ]
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.224.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.946.0",
    "@aws-sdk/client-cloudfront": "^3.946.0",
    "@aws-sdk/client-dynamodb": "^3.946.0",
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/client-sfn": "^3.946.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^24.10.1",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-cdk-lib": "^2.224.0",
    "aws-custom-resources": "^0.0.4",
    "constructs": "^10.0.0",
    "esbuild": "^0.27.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "jsii": "^5.9.44",
    "jsii-pacmak": "*",
    "jsii-rosetta": "^5.9.15",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3"
  },
  "files": [
    "src",
    "lib"
  ]
}
