{
  "name": "@serverlessinbox/mailbox",
  "version": "0.0.0",
  "author": "Joost van der Waal",
  "repository": {
    "url": "https://github.com/serverlessinbox/mailbox-cdk",
    "type": "git"
  },
  "license": "Apache-2.0",
  "description": "CDK construct library for Mailbox infrastructure",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "jsii --tsconfig tsconfig.build.json",
    "build:watch": "tsc --watch",
    "build:edge-stack": "task build:edge-stack",
    "build:data-stack": "task build:data-stack",
    "prepack": "yarn prepare-manifest build && yarn build:edge-stack && yarn build:data-stack && yarn bundle && yarn bundle:jsii",
    "test": "tsc -p tsconfig.test.json && jest",
    "clean": "rm -rf dist lib *.tsbuildinfo",
    "dev": "task build:watch",
    "bundle": "task bundle",
    "bundle:jsii": "mailbox-bundler package .",
    "publish:dev": "task publish:dev"
  },
  "publishConfig": {
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "access": "public"
  },
  "jsii": {
    "outdir": "dist",
    "tsconfig": "tsconfig.json",
    "targets": {
      "go": {
        "moduleName": "github.com/serverlessinbox/mailbox-cdk-go"
      }
    },
    "excludeTypescript": [
      "src/lambdas/**",
      "src/runtime/**"
    ]
  },
  "peerDependencies": {
    "@serverlessinbox/artifact-registry-cdk": "^0.3.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.1132.0",
    "@aws-sdk/client-cloudformation": "^3.1132.0",
    "@aws-sdk/client-cloudfront": "^3.1132.0",
    "@aws-sdk/client-dynamodb": "^3.1132.0",
    "@aws-sdk/client-eventbridge": "3.1132.0",
    "@aws-sdk/client-iam": "3.1132.0",
    "@aws-sdk/client-lambda": "^3.1132.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1132.0",
    "@aws-sdk/client-route-53": "^3.1132.0",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/client-sfn": "^3.1132.0",
    "@serverlessinbox/artifact-registry": "^0.3.0",
    "@serverlessinbox/artifact-registry-cdk": "^0.3.0",
    "@serverlessinbox/mailbox-bundler": "workspace:*",
    "@serverlessinbox/mailbox-cdk-shared": "workspace:*",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^29.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.5.0",
    "@types/unzipper": "^0.10.11",
    "aws-cdk-lib": "^2.261.0",
    "aws-custom-resources": "^0.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.27.1",
    "jest": "^29.0.0",
    "jose": "5.10.0",
    "jsii": "^5.9.44",
    "jsii-pacmak": "*",
    "jsii-rosetta": "^5.9.15",
    "mime-types": "^2.1.35",
    "semver": "^7.6.0",
    "ts-jest": "^29.0.0",
    "typanion": "^3.14.0",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3"
  },
  "files": [
    "src",
    "lib",
    "artifact-versions.json",
    "registry-record.json",
    "!src/**/__tests__",
    "!lib/**/__tests__"
  ]
}
