{
  "name": "@mailbox/infrastructure",
  "version": "1.0.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "yarn build:ts",
    "build:ts": "tsc",
    "build:cf-function": "yarn node scripts/build-cf-function.js",
    "watch": "tsc -w",
    "dev": "yarn watch",
    "aws": "aws --profile serverlessinbox-dev",
    "cdk": "cdk --profile serverlessinbox-dev",
    "deploy": "yarn build && yarn cdk deploy",
    "synth": "yarn build:ts && yarn cdk synth"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.1033.0",
    "jose": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-go-alpha": "^2.214.1-alpha.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "aws-cdk-lib": "^2.224.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.19.0",
    "jsonwebtoken": "^9.0.0",
    "source-map-support": "^0.5.21"
  }
}
