{
  "name": "mailbox-cdk",
  "version": "0.0.0",
  "private": true,
  "repository": "git@github.com:serverlessinbox/mailbox-cdk.git",
  "author": "Joost van der Waal <joost@jvdwaal.nl>",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.16.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint --config eslint.gate.config.mjs --no-error-on-unmatched-pattern packages scripts",
    "lint:all": "eslint packages scripts --max-warnings=-1",
    "resolve-artifacts": "task resolve-artifacts --",
    "bake-artifact-versions": "ts-node --project tsconfig.scripts.json scripts/bake-artifact-versions/bake-artifact-versions.ts",
    "template-baseline": "ts-node --project tsconfig.scripts.json scripts/template-baseline/template-baseline.ts",
    "build-stack": "ts-node --project tsconfig.scripts.json scripts/build-stack/build-stack.ts",
    "fetch-registry-record": "task fetch-registry-record",
    "test:scripts": "tsc -p tsconfig.scripts.json --noEmit && jest --config jest.config.js",
    "test:lint": "yarn workspace @serverlessinbox/eslint-plugin-mailbox test",
    "test": "yarn test:scripts && yarn test:lint && yarn workspace @serverlessinbox/mailbox-cdk-shared test && yarn workspace @serverlessinbox/mailbox-bundler test && yarn workspace @serverlessinbox/mailbox test && yarn workspace @serverlessinbox/mailbox-cognito test"
  },
  "devDependencies": {
    "@jwpkg/gitversion": "^1.4.0-pack-order.3",
    "@serverlessinbox/artifact-registry": "^0.3.0",
    "@serverlessinbox/artifact-registry-cdk": "^0.3.0",
    "@serverlessinbox/artifact-registry-gitversion": "^0.3.4",
    "@serverlessinbox/eslint-plugin-mailbox": "workspace:*",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.10.1",
    "aws-cdk-lib": "^2.261.0",
    "clipanion": "^4.0.0-rc.2",
    "constructs": "^10.5.0",
    "eslint": "^10",
    "eslint-plugin-arca": "^0.17.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typanion": "^3.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
